{
  "name": "design-contracts",
  "version": "0.3.0",
  "private": true,
  "description": "Scan public sites into installable Design Contracts for AI agents (resolve → check → verify).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "analyze": "ANALYZE=true next build --turbopack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:biome": "biome check --formatter-enabled=false lib/scanner lib/contracts components/providers next.config.ts vitest.config.ts",
    "lint:fix": "biome check --write lib/scanner lib/contracts lib/workers components/providers next.config.ts vitest.config.ts && eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format --check lib/scanner lib/contracts lib/workers components/providers next.config.ts vitest.config.ts",
    "knip": "knip --no-progress",
    "knip:production": "knip --production --no-progress",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check": "bun run test:unit && bun run lint:biome && bun run knip",
    "scanner:up": "docker compose up --build -d scanner",
    "scanner:down": "docker compose down",
    "scanner:logs": "docker compose logs -f scanner",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:optimize": "bun run scripts/optimize-database.ts",
    "db:optimize:indexes": "bun run scripts/apply-db-optimizations.ts",
    "db:analytics": "bun run scripts/apply-analytics-migration.ts",
    "db:seed": "bun run scripts/seed-database.ts",
    "db:reset": "bun run scripts/reset-database.ts",
    "db:health": "bun run scripts/health-check.ts",
    "db:stats": "bun run scripts/database-stats.ts",
    "db:cleanup:screenshots": "bun run scripts/cleanup-orphaned-screenshots.ts",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui",
    "test:headed": "bunx playwright test --headed",
    "test:debug": "bunx playwright test --debug",
    "test:chromium": "bunx playwright test --project=chromium",
    "test:firefox": "bunx playwright test --project=firefox",
    "test:webkit": "bunx playwright test --project=webkit",
    "test:mobile": "bunx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:api": "bunx playwright test --project=api",
    "test:stress": "bunx playwright test --project=stress-test tests/e2e/stress.spec.ts",
    "test:stress:sequential": "bunx playwright test --project=stress-test tests/e2e/stress.spec.ts -g 'Sequential'",
    "test:stress:concurrent": "bunx playwright test --project=stress-test tests/e2e/stress.spec.ts -g 'Concurrent'",
    "test:stress:advanced": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts",
    "test:stress:load": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Load Testing'",
    "test:stress:soak": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Soak Testing'",
    "test:stress:spike": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Spike Testing'",
    "test:stress:chaos": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Chaos Testing'",
    "test:stress:resource": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Resource Exhaustion'",
    "test:stress:ratelimit": "bunx playwright test --project=stress-test tests/e2e/stress-advanced.spec.ts --grep 'Rate Limit'",
    "test:performance": "bunx playwright test --project=stress-test tests/e2e/performance-baseline.spec.ts",
    "test:performance:baseline": "bunx playwright test --project=stress-test tests/e2e/performance-baseline.spec.ts -g 'Performance Baselines'",
    "test:performance:bottleneck": "bunx playwright test --project=stress-test tests/e2e/performance-baseline.spec.ts -g 'Bottleneck Detection'",
    "test:performance:capacity": "bunx playwright test --project=stress-test tests/e2e/performance-baseline.spec.ts -g 'Capacity Planning'",
    "test:visual": "bunx playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "bunx playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:report": "bunx playwright show-report tests/reports/html",
    "test:install": "playwright install --with-deps",
    "test:accessibility": "bunx playwright test --project=accessibility",
    "test:accessibility:report": "bunx playwright test --project=accessibility --reporter=html",
    "audit:accessibility": "bun run scripts/accessibility-audit.ts",
    "lint:accessibility": "bun run test:accessibility && bun run audit:accessibility"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.24",
    "@ai-sdk/react": "^4.0.45",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@projectwallace/css-analyzer": "^7.6.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.1",
    "extract-css-core": "^3.0.0",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^3.4.0",
    "input-otp": "^1.4.2",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "openai": "^7.2.0",
    "p-limit": "^7.3.1",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "postcss-safe-parser": "^7.0.1",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "style-dictionary": "^5.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tar-fs": "^3.1.1",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4",
    "@vitest/ui": "^4",
    "axe-core": "^4.12.1",
    "axe-html-reporter": "^2.2.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "critters": "^0.0.25",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "lighthouse": "^12.8.2",
    "pa11y": "^9.0.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4"
  }
}
