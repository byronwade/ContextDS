# designcontracts.sh — free serverless setup (no paid database)

# Public site URL (sitemap / robots / canonicals)
NEXT_PUBLIC_SITE_URL=https://designcontracts.sh

# Vercel Blob (Hobby free tier) — durable scan JSON + screenshots
BLOB_READ_WRITE_TOKEN=

# Upstash Redis free tier — site index, recent/popular lists, rate limits
# Create at https://console.upstash.com (free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy aliases also supported:
# REDIS_URL=
# REDIS_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Accurate scans: Docker Playwright microservice (scanner/)
# Local:  docker compose up --build -d scanner
#         SCANNER_SERVICE_URL=http://localhost:4040
# Vercel: deploy `scanner/` as its own project (Root Directory = scanner)
#         then point the Next app at that HTTPS URL, e.g.
# Production scanner (uploaded):
# SCANNER_SERVICE_URL=https://designcontracts-scanner.vercel.app
SCANNER_SERVICE_URL=http://localhost:4040
# Shared secret (same value on scanner + Next app; header x-scanner-secret)
# SCANNER_SERVICE_SECRET=
# Optional scanner concurrency limit (default 2)
# SCANNER_MAX_CONCURRENCY=2

# Vercel AI Gateway — Design Contract agent + enrichment
# Local: create a key at https://vercel.com/docs/ai-gateway
# On Vercel: OIDC works without a key
AI_GATEWAY_API_KEY=
# Optional model overrides (provider/model slugs via Gateway)
# DESIGN_AGENT_MODEL=openai/gpt-5.4-mini
# DESIGN_FAST_MODEL=openai/gpt-5.4-mini
# DESIGN_VISION_MODEL=openai/gpt-5.4-mini

# Stripe — Design Contracts Pro ($9/mo, App Packs)
# 1) Create Product "Design Contracts Pro" + recurring Price $9/mo
# 2) Copy Price id → STRIPE_PRICE_PRO
# 3) Webhook endpoint: https://<host>/api/billing/webhook
#    events: checkout.session.completed, customer.subscription.created|updated|deleted
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Optional cookie signing secret (falls back to STRIPE_SECRET_KEY)
# BILLING_COOKIE_SECRET=
# Local unlock for App Packs without Stripe
# BILLING_BYPASS=1

# Force fast mode only (skip computed CSS / local Playwright fallback)
# DISABLE_COMPUTED_CSS=1

# Optional Supabase Auth only (NOT used for scan storage)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DEPRECATED — Postgres is no longer required for scanning/storage
# DATABASE_URL=
