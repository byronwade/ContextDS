# ContextDS — Cloudflare D1 backend
# Copy to .env.local for local development

# Use D1 stub during Next.js production builds (avoids wrangler at compile time)
CONTEXTDS_USE_BUILD_STUB=true

# Optional: point Next.js API routes at the Cloudflare Worker in dev
# CONTEXTDS_WORKER_URL=http://localhost:8787

# Session signing (generate a random 32+ char secret)
AUTH_SECRET=change-me-to-a-long-random-string

# Cron job authentication
CRON_SECRET=change-me-cron-secret

# AI / scanning
OPENAI_API_KEY=
VERCEL_AI_GATEWAY_URL=

# Rate limiting (Upstash Redis — optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics / monitoring (optional)
SIEM_ENDPOINT=
SECURITY_ALERT_WEBHOOKS=
DATA_ERASURE_WEBHOOKS=

# Cloudflare (for remote D1 deploy via wrangler)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
