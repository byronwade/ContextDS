{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,default,template}.{ts,tsx}",
    "app/**/sitemap.{ts,tsx}",
    "app/**/robots.{ts,tsx}",
    "scripts/**/*.{ts,js,mjs}",
    "scanner/server.mjs"
  ],
  "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
  "ignore": [
    ".next/**",
    "coverage/**",
    "tests/reports/**",
    "lib/db/migrations/**",
    "drizzle.config.ts",
    "components/ui/**",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "critters",
    "tw-animate-css",
    "tailwindcss-animate",
    "tailwindcss",
    "axe-core",
    "axe-html-reporter",
    "@projectwallace/extract-css-core",
    "@ai-sdk/openai",
    "@hookform/resolvers",
    "react-hook-form",
    "cmdk",
    "date-fns",
    "embla-carousel-react",
    "input-otp",
    "next-themes",
    "react-day-picker",
    "react-resizable-panels",
    "recharts",
    "sonner",
    "vaul",
    "style-dictionary",
    "extract-css-core",
    "esbuild",
    "tar-fs",
    "@radix-ui/react-accordion",
    "@radix-ui/react-alert-dialog",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-avatar",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-context-menu",
    "@radix-ui/react-dialog",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-popover",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-separator",
    "@radix-ui/react-slider",
    "@radix-ui/react-switch",
    "@radix-ui/react-toggle",
    "@radix-ui/react-toggle-group",
    "@radix-ui/react-tooltip"
  ],
  "exclude": ["files", "exports", "types", "nsExports", "nsTypes", "enumMembers", "duplicates"],
  "next": true,
  "vitest": true,
  "playwright": true,
  "eslint": true
}
